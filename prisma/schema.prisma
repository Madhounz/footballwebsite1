// ninety — PostgreSQL schema
// Standings and scorer charts are derived from matches/events at read time so
// they can never disagree with the results shown elsewhere on the site.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Competition {
  id          String            @id // "epl"
  slug        String            @unique
  name        String
  shortName   String
  country     String
  countryCode String
  kind        String // league | cup
  tier        Int               @default(1) // 1 = top flight, 2 = the division below it
  order       Int
  season      String
  teamCount   Int
  rounds      Int
  color       String
  zones       Json // TableZone[]
  teams       TeamCompetition[]
  matches     Match[]
  updatedAt   DateTime          @updatedAt
  scorerChart SeasonScorer[]
}

model Team {
  id           String            @id
  slug         String            @unique
  name         String
  shortName    String
  code         String
  country      String
  countryCode  String
  city         String
  stadium      String
  founded      Int
  colors       String[] // [primary, secondary]
  manager      String?
  leagueId     String?
  crestUrl     String?
  competitions TeamCompetition[]
  players      Player[]
  homeMatches  Match[]           @relation("home")
  awayMatches  Match[]           @relation("away")
  events       MatchEvent[]
  lineups      Lineup[]
  updatedAt    DateTime          @updatedAt
  scorerRows   SeasonScorer[]
}

model TeamCompetition {
  teamId        String
  competitionId String
  season        String
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([teamId, competitionId, season])
  @@index([competitionId, season])
}

model Player {
  id              String         @id
  slug            String         @unique
  name            String
  firstName       String
  lastName        String
  teamId          String
  team            Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  position        String // GK | DF | MF | FW
  shirtNumber     Int
  nationality     String
  nationalityCode String
  dateOfBirth     DateTime       @db.Date
  heightCm        Int?
  preferredFoot   String?
  events          MatchEvent[]
  updatedAt       DateTime       @updatedAt
  scorerRows      SeasonScorer[]

  @@index([teamId])
}

model Match {
  id             String       @id
  /**
   * Readable URL segment; see src/lib/match-slug.ts.
   */
  slug           String       @unique
  competitionId  String
  competition    Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  season         String
  round          Int
  stage          String?
  kickoff        DateTime
  homeTeamId     String
  awayTeamId     String
  home           Team         @relation("home", fields: [homeTeamId], references: [id])
  away           Team         @relation("away", fields: [awayTeamId], references: [id])
  status         String // scheduled | live | finished | postponed | cancelled
  phase          String // NS | 1H | HT | 2H | ET | PEN | FT
  minute         Int?
  homeScore      Int?
  awayScore      Int?
  homeHtScore    Int?
  awayHtScore    Int?
  venue          String?
  attendance     Int?
  referee        String?
  events         MatchEvent[]
  lineups        Lineup[]
  /**
   * When the full post-match event list was fetched. Null means the timeline may still be incomplete.
   */
  eventsFinalAt  DateTime?
  /**
   * 0..1 agreement between providers for the scoreline; see Discrepancy.
   */
  confidence     Float        @default(1)
  /**
   * Sources disagreed on a settled result; the primary source's value is shown, flagged for review.
   */
  disputed       Boolean      @default(false)
  disputedFields String[]
  updatedAt      DateTime     @updatedAt

  @@index([kickoff])
  @@index([competitionId, season, round])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([status])
  @@index([status, eventsFinalAt])
}

model MatchEvent {
  id              String  @id
  matchId         String
  match           Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  minute          Int
  addedTime       Int?
  teamId          String
  team            Team    @relation(fields: [teamId], references: [id])
  type            String
  playerId        String?
  player          Player? @relation(fields: [playerId], references: [id])
  relatedPlayerId String?
  detail          String?

  @@index([matchId])
  @@index([playerId])
}

model Lineup {
  matchId   String
  teamId    String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team      Team    @relation(fields: [teamId], references: [id])
  formation String
  starting  Json // LineupPlayer[]
  bench     Json // LineupPlayer[]
  coach     String?

  @@id([matchId, teamId])
}

// ---------------------------------------------------------------------------
// Provenance — what each provider said, and how disagreements were settled.
// ---------------------------------------------------------------------------

model SyncRun {
  id             String        @id @default(cuid())
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  trigger        String // cron | manual
  /**
   * full = whole season, live = today only, seed = also teams and squads.
   */
  mode           String        @default("full")
  providers      String[]
  fetched        Int           @default(0)
  written        Int           @default(0)
  conflicts      Int           @default(0)
  aiResolved     Int           @default(0)
  /**
   * Requests spent on the metered detail provider; paces the live refresh.
   */
  detailRequests Int           @default(0)
  error          String?
  discrepancies  Discrepancy[]

  @@index([startedAt])
}

model SourceRecord {
  id         String   @id @default(cuid())
  provider   String // football-data | api-football | …
  entityType String // match | standing | team | player
  entityId   String // our canonical id
  externalId String
  payload    Json
  fetchedAt  DateTime @default(now())

  @@unique([provider, entityType, externalId])
  @@index([entityType, entityId])
}

model Discrepancy {
  id         String    @id @default(cuid())
  runId      String?
  run        SyncRun?  @relation(fields: [runId], references: [id])
  entityType String
  entityId   String
  field      String
  /**
   * { provider: value }
   */
  values     Json
  resolution Json? // the chosen value
  resolvedBy String? // consensus | ai | manual | unresolved
  confidence Float?
  reasoning  String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([entityType, entityId])
  @@index([resolvedBy])
}

model EntityAlias {
  id           String @id @default(cuid())
  entityType   String // team | player | competition
  entityId     String
  provider     String
  externalId   String
  externalName String
  source       String // seed | ai | manual
  confidence   Float  @default(1)

  @@unique([provider, entityType, externalId])
  @@index([entityType, entityId])
}

/// A competition's scorer chart exactly as the primary source publishes it.
/// Not derived from our events: the free plan cannot hand us every match's
/// goals, so counting them ourselves would publish a chart that is quietly
/// short. See docs/DATA-PIPELINE.md.
model SeasonScorer {
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  season        String
  /// Position in the provider's own ordering.
  rank          Int
  playerId      String
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  teamId        String
  team          Team        @relation(fields: [teamId], references: [id])
  goals         Int
  assists       Int         @default(0)
  penalties     Int         @default(0)
  appearances   Int         @default(0)
  provider      String
  updatedAt     DateTime    @updatedAt

  @@id([competitionId, season, playerId])
  @@index([competitionId, season, goals])
}
